#include "{{ service_name | lower_snake }}.h"

#include <stdlib.h>

// Every object is prefixed with a marker so field data can never be
// mistaken for NULL: SENTINEL_PRESENT = object follows, SENTINEL_NULL = NULL.
#define SENTINEL_PRESENT 0x00000000u
#define SENTINEL_NULL    0xFFFFFFFFu

{% for type_name, type_info in types.items() %}
{% set t = type_name | lower_snake %}
void serialize_{{ t }}_t(struct {{ t }}_t *obj, ser_buff_t *buff) {
  unsigned int sentinel = obj ? SENTINEL_PRESENT : SENTINEL_NULL;
  serialize_data(buff, (char *)&sentinel, sizeof(unsigned int));

  if (!obj) {
    return;
  }

  {% for field in type_info.fields %}
    {% if field.type in types %}
  serialize_{{ field.type | lower_snake }}_t(&obj->{{ field.name }}, buff);
    {% else %}
  serialize_data(buff, (char *)&obj->{{ field.name }}, sizeof(obj->{{ field.name }}));
    {% endif %}
  {% endfor %}
}

struct {{ t }}_t *deserialize_{{ t }}_t(ser_buff_t *buff) {
  unsigned int sentinel = 0;
  deserialize_data((char *)&sentinel, buff, sizeof(unsigned int));

  if (sentinel == SENTINEL_NULL) {
    return NULL;
  }

  struct {{ t }}_t *obj = calloc(1, sizeof(struct {{ t }}_t));

  {% for field in type_info.fields %}
    {% if field.type in types %}
  // nested struct is embedded by value: copy from the heap object, then free it
  struct {{ field.type | lower_snake }}_t *nested_{{ field.name }} = deserialize_{{ field.type | lower_snake }}_t(buff);
  if (nested_{{ field.name }}) {
    obj->{{ field.name }} = *nested_{{ field.name }};
    free(nested_{{ field.name }});
  }
    {% else %}
  deserialize_data((char *)&obj->{{ field.name }}, buff, sizeof(obj->{{ field.name }}));
    {% endif %}
  {% endfor %}

  return obj;
}

{% endfor %}
