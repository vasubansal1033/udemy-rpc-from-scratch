#ifndef {{ service_name | upper_snake }}_H
#define {{ service_name | upper_snake }}_H

#include <stdint.h>
#include <stdbool.h>
#include "stream.h"

{% for type_name, type_info in types.items() %}
struct {{ type_name | lower_snake }}_t {
  {% for field in type_info.fields %}
    {% if field.type == 'string' %}
    {{ language_datastructure_dict[field.type] }} {{ field.name }}[{{ field.maxLength }}];
    {% elif field.type in types %}
    struct {{ field.type | lower_snake }}_t {{ field.name }};
    {% else %}
    {{ language_datastructure_dict.get(field.type, field.type) }} {{ field.name }};
    {% endif %}
  {% endfor %}
};

void serialize_{{ type_name | lower_snake }}_t(struct {{ type_name | lower_snake }}_t *obj, ser_buff_t *buff);
struct {{ type_name | lower_snake }}_t *deserialize_{{ type_name | lower_snake }}_t(ser_buff_t *buff);

{% endfor %}
#endif // {{ service_name | upper_snake }}_H
