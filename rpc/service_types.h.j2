#ifndef {{ service_name | upper_snake }}_H
#define {{ service_name | upper_snake }}_H

#include <stdint.h>
#include <stdbool.h>
#include <stdlib.h>
#include <stream.h>

{% for type_name, type_info in types.items() %}
struct {{ type_name | lower_snake }}_t {
  {% for field in type_info.fields %}
    {% if field.type == 'string' and field.maxLength %}
    char {{ field.name }}[{{ field.maxLength }}];
    {% else %}
    {{ language_datastructure_dict.get(field.type, field.type) }} {{ field.name }};
    {% endif %}
  {% endfor %}
};

void serialize_{{ type_name | lower_snake }}_t(
  struct {{ type_name | lower_snake }}_t *obj,
  ser_buff_t *buff
) {
  
  // sentinel detection code
  if (!obj) {
    unsigned int sentienel = 0xFFFFFFFF;
    serialize_data(buff, (char *)&sentinel, sizeof(unsigned int));

    return;
  }

  {% for field in type_info.fields %}
    {% if field.type == 'string' %}
  serialize_data(buff, (char *)obj->{{ field.name }}, sizeof(char) * {{ field.maxLength }})
    {% else %}
  serialize_data(buff, (char *)&obj->{{ field.name }}, sizeof({{ language_datastructure_dict.get(field.type) }}))
    {% endif %}
  {% endfor%}
 
};

struct {{ type_name | lower_snake }} *deserialize_{{ type_name | lower_snake }}(
  ser_buff_t *buff
) {
    // sentinel detection code
    unsigned int sentinel = 0;
    deserialize_data((char *) &sentinel, buff, sizeof(unsigned int));
    
    if (sentinel == 0xFFFFFFFF) {
        return NULL;
    }

    serialize_buffer_skip_bytes(buff, -1 * sizeof(unsigned int));

    struct {{ type_name | lower_snake }} *obj = calloc(1, sizeof(struct {{ type_name | lower_snake }}));

    {% for field in type_info.fields %}
      {% if field.type == 'string' %}
    deserialize_data((char *)obj->{{ field.name }}, buff, sizeof(char) * {{ field.maxLength }})
      {% else %}
    deserialize_data((char *)&obj->{{ field.name }}, buff, sizeof({{ language_datastructure_dict.get(field.type) }}))
      {% endif %}
    {% endfor %}

    return obj;
  } 

{% endfor %}
#endif // {{ service_name | upper_snake }}_H

